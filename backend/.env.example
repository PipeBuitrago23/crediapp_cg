# Copy to .env for running the backend outside docker-compose (e.g. `uvicorn main:app --reload`).
# Inside docker-compose, these are already injected via docker-compose.yml (DATABASE_URL) and the
# repo-root .env (SMTP_USER/SMTP_PASSWORD, see ../.env.example) — this file is not read in that case.
DATABASE_URL=postgresql+asyncpg://admin:supersecretpassword@localhost:5432/crediapp_db
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Secreto usado para firmar los JWT de admin/cliente. Genera uno propio, ej. con
# `python -c "import secrets; print(secrets.token_hex(32))"` — nunca reuses este valor de ejemplo.
JWT_SECRET=cambia-este-valor-por-uno-generado-aleatoriamente
# Opcional: lista de orígenes permitidos por CORS separados por coma (ej. el dominio
# del frontend en Railway). Sin setear, se permite cualquier origen (default de dev).
CORS_ORIGINS=
