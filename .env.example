# Docker Compose reads a file named `.env` in this same folder automatically
# and substitutes ${SMTP_USER} / ${SMTP_PASSWORD} in docker-compose.yml with it.
# Copy this file to `.env` and fill in real values — `.env` is gitignored and
# must never be committed (unlike the throwaway local Postgres password in
# docker-compose.yml, these are real Gmail credentials).
#
# SMTP_PASSWORD must be a 16-character Gmail "App Password"
# (https://myaccount.google.com/apppasswords), not your normal Gmail password —
# Gmail requires 2-Step Verification to be enabled to generate one.
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Secret used to sign admin/client JWTs (backend/security.py). Generate your own,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"` — the app fails
# to start without this set, unlike the SMTP vars above which soft-degrade.
JWT_SECRET=

# Optional: comma-separated list of allowed CORS origins (e.g. the frontend's
# Railway domain once assigned). Unset means "allow any origin" (local dev default).
CORS_ORIGINS=
